rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function role() { return get(/databases/$(db)/documents/users/$(request.auth.token.email)).data.role; }
    match /users/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || role() == 'admin');
      allow write: if signedIn() && role() == 'admin';
    }
    match /employees/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && role() in ['admin','hr'];
    }
    match /assessments/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && role() in ['admin','hr','lm','hod'];
    }
  }
}
